          },
          {
            "context": "capability-diff-sim",
            "integration_id": 15368
          },
          {
            "context": "install-smoke",
            "integration_id": 15368
          },
          {
            "context": "baseline-delta-pr",
            "integration_id": 15368
          },
          {
            "context": "Public Artifact Sanitization",
            "integration_id": 15368
          },
          {
            "context": "required-zero-pr",
            "integration_id": 15368
          },
          {
            "context": "default-discovery-sandbox",
            "integration_id": 15368
          }
        ]
