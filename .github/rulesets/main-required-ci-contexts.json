{
  "name": "main-required-ci-contexts",
  "note": "Local inventory of live required check contexts. Not an imported GitHub ruleset; live main protection is operator-managed.",
  "target": "branch",
  "enforcement": "inventory",
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH",
        "refs/heads/release/*"
      ],
      "exclude": []
